{
  "name": "nearpay",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@infinitered/react-native-mlkit-face-detection": "^5.0.0",
    "expo": "~58.0.19",
    "expo-camera": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "jpeg-js": "^0.4.4",
    "react": "19.3.1",
    "react-native": "0.88.0",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android",
    "server:dev": "pnpm --filter @nearpay/server dev",
    "server:build": "pnpm --filter @nearpay/server build",
    "server:typecheck": "pnpm --filter @nearpay/server typecheck",
    "server:migrate": "pnpm --filter @nearpay/server db:migrate",
    "server:keygen": "pnpm --filter @nearpay/server keygen",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint"
  },
  "private": true
}
