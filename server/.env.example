PORT=4310
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=postgres://nearpay:replace-me@localhost:5432/nearpay
DATABASE_SSL=false
AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-bytes
BIOMETRIC_ENCRYPTION_KEY=replace-with-output-from-pnpm-server-keygen
APP_ORIGINS=*
TRUST_PROXY=false
PAYPAL_CLIENT_ID=replace-with-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-sandbox-client-secret
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
# Local Android demo: http://127.0.0.1:4310 (with `adb reverse tcp:4310 tcp:4310`).
# Hosted demo: replace with the public HTTPS API origin.
PUBLIC_API_ORIGIN=http://127.0.0.1:4310
# Optional PayPal partner code, required only if PayPal issued one for your integration.
# PAYPAL_PARTNER_ATTRIBUTION_ID=replace-with-paypal-issued-partner-code
